# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory_platform
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------
# API
# ------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
SALT_ROUNDS=12

# ------------------------------------------------------------------
# Edge service
# ------------------------------------------------------------------
EDGE_DB_PATH=./data/edge.sqlite
EDGE_ORGANIZATION_ID=
EDGE_STORE_ID=
EDGE_TERMINAL_ID=
EDGE_API_URL=http://localhost:4000/api/v1
EDGE_TERMINAL_TOKEN=
EDGE_SYNC_INTERVAL_MS=15000
EDGE_MAX_RETRY_DELAY_MS=60000
