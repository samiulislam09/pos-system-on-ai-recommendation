// ============================================================================
// Multi-Store Inventory & Transaction Platform — Prisma Schema
// PostgreSQL is the single source of truth.
// Design pillars: ledger-based inventory, idempotent events, multi-tenancy,
// database-level integrity, auditability, AI-ready historical data.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  MANAGER
  STORE_MANAGER
  INVENTORY_MANAGER
  CASHIER
  VIEWER
}

enum LocationType {
  STORE
  WAREHOUSE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_PAYMENT
  BANK_TRANSFER
  CREDIT
  OTHER
}

enum SaleReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum TransferStatus {
  DRAFT
  PENDING
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum AdjustmentReason {
  DAMAGED
  LOST
  STOCK_COUNT_VARIANCE
  FOUND
  MANUAL_CORRECTION
  OTHER
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum MovementType {
  PURCHASE
  SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
  STOCK_COUNT
}

enum EventType {
  SALE
  RETURN
  PURCHASE_RECEIVE
  TRANSFER_RECEIVE
  STOCK_ADJUSTMENT
  STOCK_COUNT
}

enum EventProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

// ---------------------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  locations      Location[]
  postTerminals  PostTerminal[]
  categories     Category[]
  brands         Brand[]
  products       Product[]
  variants       ProductVariant[]
  suppliers      Supplier[]
  inventory      Inventory[]
  movements      InventoryMovement[]
  sales          Sale[]
  salesReturns   SaleReturn[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  transfers      StockTransfer[]
  adjustments    StockAdjustment[]
  events         TransactionEvent[]
  auditLogs      AuditLog[]
}

model User {
  id             String     @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name           String
  email          String     @unique
  passwordHash   String
  role           UserRole   @default(VIEWER)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastLoginAt    DateTime?

  refreshTokens RefreshToken[]
  adjustments   StockAdjustment[] @relation("AdjustedBy")
  auditLogs     AuditLog[]

  @@index([organizationId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Locations, Stores, POS terminals
// ---------------------------------------------------------------------------

model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  type           LocationType @default(STORE)
  address        String?
  status         EntityStatus @default(ACTIVE)
  settings       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  postTerminals  PostTerminal[]
  inventory      Inventory[]
  movements      InventoryMovement[]
  sales          Sale[]
  salesReturns   SaleReturn[]
  goodsReceipts  GoodsReceipt[]
  purchaseOrders PurchaseOrder[]
  transfersFrom  StockTransfer[] @relation("TransferSource")
  transfersTo    StockTransfer[] @relation("TransferDestination")
  adjustments    StockAdjustment[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model PostTerminal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId        String
  store          Location     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  terminalCode   String
  status         EntityStatus @default(ACTIVE)
  lastSyncAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sales Sale[]

  @@unique([organizationId, terminalCode])
  @@index([storeId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  parentId       String?
  parent         Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryTree")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Brand {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  description    String?
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit           String       @default("pcs")
  costPrice      Decimal      @db.Decimal(12, 2)
  sellingPrice   Decimal      @db.Decimal(12, 2)
  reorderLevel   Int          @default(0)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  variants       ProductVariant[]
  saleItems      SaleItem[]
  saleReturnItems SaleReturnItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems GoodsReceiptItem[]
  transferItems  StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  inventory      Inventory[]
  movements      InventoryMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, brandId])
}

model ProductVariant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String
  barcode        String?      @unique
  size           String?
  color          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, sku])
  @@index([productId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Suppliers & Purchasing
// ---------------------------------------------------------------------------

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PurchaseOrder {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poNumber       String             @unique
  supplierId     String
  supplier       Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  locationId     String             @default("")
  location       Location?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status         PurchaseOrderStatus @default(DRAFT)
  expectedAt     DateTime?
  totalAmount    Decimal            @default(0) @db.Decimal(12, 2)
  notes          String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items          PurchaseOrderItem[]
  goodsReceipts  GoodsReceipt[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([organizationId, status])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Int
  receivedQuantity Int           @default(0)
  unitCost         Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)

  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receiptNumber  String       @unique
  receivedById   String?
  notes          String?
  createdAt      DateTime     @default(now())

  items GoodsReceiptItem[]

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([locationId])
}

model GoodsReceiptItem {
  id                String            @id @default(cuid())
  goodsReceiptId    String
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity          Int
  unitCost          Decimal           @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)

  @@index([goodsReceiptId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Sales, Returns, Payments
// ---------------------------------------------------------------------------

model Sale {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId        String
  store          Location      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  terminalId     String?
  terminal       PostTerminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  transactionNumber String     @unique
  status         SaleStatus    @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paymentStatus  PaymentStatus @default(PAID)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items       SaleItem[]
  payments    Payment[]
  returns     SaleReturn[]

  @@index([organizationId])
  @@index([storeId, createdAt])
  @@index([organizationId, createdAt])
  @@index([status])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  tax       Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  returns SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod @default(CASH)
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  status    PaymentStatus @default(PAID)
  createdAt DateTime      @default(now())

  @@index([saleId])
}

model SaleReturn {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId        String
  store          Location         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  saleId         String?
  sale           Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  returnNumber   String           @unique
  status         SaleReturnStatus @default(REQUESTED)
  reason         String?
  total          Decimal          @default(0) @db.Decimal(12, 2)
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items     SaleReturnItem[]

  @@index([organizationId])
  @@index([storeId])
  @@index([saleId])
}

model SaleReturnItem {
  id             String       @id @default(cuid())
  returnId       String
  return         SaleReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId     String?
  saleItem       SaleItem?    @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPrice      Decimal      @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)

  @@index([returnId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Inventory — ledger + balance
// ---------------------------------------------------------------------------

model Inventory {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId       String
  location         Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity         Int          @default(0)
  reservedQuantity Int          @default(0)
  updatedAt        DateTime     @updatedAt

  @@unique([productId, locationId])
  @@index([organizationId])
  @@index([locationId])
  @@index([productId, locationId])
}

model InventoryMovement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type           MovementType
  quantity       Int
  referenceType  String
  referenceId    String
  metadata       Json?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([productId, locationId, createdAt])
  @@index([locationId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Stock transfers
// ---------------------------------------------------------------------------

model StockTransfer {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transferNumber      String         @unique
  sourceLocationId    String
  sourceLocation      Location       @relation("TransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocationId String
  destinationLocation Location       @relation("TransferDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  status              TransferStatus @default(DRAFT)
  createdById         String?
  approvedById        String?
  shippedById         String?
  receivedById        String?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  approvedAt          DateTime?
  shippedAt           DateTime?
  receivedAt          DateTime?
  cancelledAt         DateTime?

  items StockTransferItem[]

  @@index([organizationId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([organizationId, status])
}

model StockTransferItem {
  id             String        @id @default(cuid())
  transferId     String
  transfer       StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  receivedQuantity Int         @default(0)

  @@index([transferId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Stock adjustments
// ---------------------------------------------------------------------------

model StockAdjustment {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reason         AdjustmentReason @default(MANUAL_CORRECTION)
  status         EntityStatus     @default(ACTIVE)
  createdById    String?
  createdBy      User?            @relation("AdjustedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items StockAdjustmentItem[]

  @@index([organizationId])
  @@index([locationId])
  @@index([createdAt])
}

model StockAdjustmentItem {
  id               String          @id @default(cuid())
  adjustmentId     String
  adjustment       StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Int
  reason           AdjustmentReason @default(MANUAL_CORRECTION)

  @@index([adjustmentId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Transaction events (idempotency + offline ingestion)
// ---------------------------------------------------------------------------

model TransactionEvent {
  id             String              @id @default(cuid())
  eventId        String              @unique
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId        String
  terminalId     String?
  type           EventType
  payload        Json
  status         EventProcessingStatus @default(RECEIVED)
  transactionId  String?
  error          String?
  createdAt      DateTime            @default(now())
  processedAt    DateTime?

  @@index([eventId])
  @@index([organizationId, createdAt])
  @@index([storeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String
  oldValue       Json?
  newValue       Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}