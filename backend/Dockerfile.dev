# Development image for the backend monorepo (api / worker).
# Source is bind-mounted by docker-compose; node_modules live in named volumes
# that are seeded from the layers below, so nothing from the macOS host leaks in.
FROM node:22-bookworm-slim

# Prisma's query engine needs libssl at runtime. procps provides `ps`, which
# `nest start --watch` uses to find and kill the old app process on reload;
# without it the old process keeps port 4000 and the restart fails with
# EADDRINUSE.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates procps \
 && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=development
# Only needed so `prisma generate` can resolve the datasource at image-build
# time. Compose overrides it at runtime.
ENV DATABASE_URL=postgresql://inventory:inventory@postgres:5432/inventory_platform

WORKDIR /app

# Manifests first so `npm ci` is cached independently of source changes.
COPY package.json package-lock.json turbo.json tsconfig.base.json ./
COPY apps/api/package.json        apps/api/
COPY apps/worker/package.json     apps/worker/
COPY apps/edge/package.json       apps/edge/
COPY packages/config/package.json     packages/config/
COPY packages/database/package.json   packages/database/
COPY packages/events/package.json     packages/events/
COPY packages/types/package.json      packages/types/
COPY packages/validation/package.json packages/validation/

# The root `postinstall` runs `prisma generate`, which needs the schema.
COPY packages/database/prisma packages/database/prisma

RUN npm ci

# Source is replaced by the bind mount at runtime; this only makes the image
# usable standalone (e.g. `docker run` without compose).
COPY . .

EXPOSE 4000
CMD ["npm", "run", "dev:api"]
